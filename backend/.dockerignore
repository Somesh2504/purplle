# Prevent node_modules from being sent to Docker build context.
# The Dockerfile runs `npm ci` inside the image — it does not need
# the host's node_modules directory at all.
node_modules/

# Logs
npm-debug.log*
*.log

# Environment files — never bake secrets into images
.env
.env.*

# OS artifacts
.DS_Store
Thumbs.db

# Editor configs
.vscode/
.idea/

# Git
.git/
.gitignore
